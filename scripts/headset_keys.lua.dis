-- headset_keys.lua
-- Hỗ trợ nút bấm vật lý trên tai nghe (Play/Pause, Next, Prev)
-- Dùng được với tai nghe Bluetooth hoặc có dây, nếu hệ điều hành map thành media keys.

-- Play/Pause
mp.add_key_binding("Media_Play_Pause", "toggle-pause", function()
    mp.command("cycle pause")
end)

-- Có tai nghe chỉ gửi "Play"
mp.add_key_binding("Media_Play", "play", function()
    mp.set_property("pause", "no")
end)

-- Có tai nghe chỉ gửi "Pause"
mp.add_key_binding("Media_Pause", "pause", function()
    mp.set_property("pause", "yes")
end)

-- Next
mp.add_key_binding("Media_Next", "next", function()
    mp.command("playlist-next")
end)

-- Previous
mp.add_key_binding("Media_Prev", "prev", function()
    mp.command("playlist-prev")
end)
