--[[
  Log radio title to file
]]--

local settings = {
    log_playlist = "scripts/log/radio.log", -- log songs to file
}

require 'mp.options'
read_options(settings, "logradio")

function log_to_file(name, value)
    if not value then return end
    local file = io.open(settings.log_playlist, "a+")
    if file then
        local log_line = string.format("%s - %s\n", os.date('%Y-%m-%d %H:%M:%S'), value)
        file:write(log_line)
        file:close()
    else
        mp.msg.error("Cannot open log file: " .. settings.log_playlist)
    end
end

function enable_script()
  mp.observe_property("media-title", "string", log_to_file)
end

-- Wait 5s for mpv to open stream
mp.add_timeout(5, enable_script)
