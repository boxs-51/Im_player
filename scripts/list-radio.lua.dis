local mp = require 'mp'
local utils = require 'mp.utils'

local max_videos = 100
local batch_size = 5
local existing_videos = {}

-- Lấy tất cả URL từ playlist hiện tại của MPV
local function get_mpv_playlist_urls()
    local urls = {}
    local plist = mp.get_property_native("playlist")

    if plist then
        for _, item in ipairs(plist) do
            -- item.filename chính là URL hoặc path
            urls[item.filename] = true
        end
    end

    return urls
end

-- Kiểm tra radio playlist
local function is_radio_playlist(url)
    if not url then return false end
    if not string.match(url, "^https?://") then return false end
    if string.match(url, "start_radio=1") then return true end

    local args = {"yt-dlp", "-J", "--flat-playlist", url}
    local res = utils.subprocess({args=args, cancellable=false, capture_stdout=true, capture_stderr=true})
    if res.status ~= 0 then return false end
    local info = utils.parse_json(res.stdout)
    if info and info._type == "playlist" and info.entries and #info.entries > 0 then
        return true
    end
    return false
end

local function fetch_entries(url)
    if not url then return {} end

    -- Playlist hiện tại của MPV
    local current_urls = get_mpv_playlist_urls()

    local args = {"yt-dlp", "-J", "--flat-playlist", url}
    local res = utils.subprocess({args=args, cancellable=false, capture_stdout=true, capture_stderr=true})
    if res.status ~= 0 then return {} end
    local info = utils.parse_json(res.stdout)
    if not info or not info.entries then return {} end

    local entries = {}
    local count = 0

    for _, e in ipairs(info.entries) do
        if count >= max_videos then break end
        if e.id then
            local video_url = "https://www.youtube.com/watch?v="..e.id

            -- ✅ NEW: Loại video đã tồn tại trong playlist MPV
            if not current_urls[video_url] and not existing_videos[video_url] then
                table.insert(entries, {
                    id = e.id,
                    title = e.title,
                    url = video_url
                })
                existing_videos[video_url] = true
                count = count + 1
            end
        end
    end
    return entries
end

local function append_videos_batch(entries)
    local i = 1
    local total = #entries

    local function append_next()
        local end_idx = math.min(i + batch_size - 1, total)
        for j = i, end_idx do
            local v = entries[j]
            mp.commandv("loadfile", v.url, "append-play")
            mp.msg.info("[APPEND]", v.id, v.title)
        end
        i = end_idx + 1
        if i <= total then
            mp.add_timeout(0.1, append_next)
        end
    end

    append_next()
end

-- load URL mới
local function on_file_loaded(name, value)
    if value and is_radio_playlist(value) then
        local entries = fetch_entries(value)
        if #entries > 0 then
            append_videos_batch(entries)
        end
    end
end

mp.observe_property("path", "string", on_file_loaded)
mp.msg.info("Radio pipeline listener started")
