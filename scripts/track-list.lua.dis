-- track_format_minimal.lua
-- Lấy format + codec + resolution cho local/URL
-- Chỉ cache RAM, không tạo file cache

local mp = require 'mp'
local utils = require 'mp.utils'

-- ================= CACHE RAM =================
local cache = {} -- key = path hoặc URL

-- ================= LOG HELPER =================
local script_path = debug.getinfo(1, "S").source:sub(2)
local script_dir  = utils.split_path(script_path) or "."

local function ensure_dir(path)
    local sep = package.config:sub(1,1)
    local cmd
    if sep == "\\" then
        cmd = string.format('if not exist "%s" mkdir "%s"', path, path)
    else
        cmd = string.format('mkdir -p "%s"', path)
    end
    os.execute(cmd)
end

local function make_logfile(path)
    local logdir = utils.join_path(script_dir, "log")
    ensure_dir(logdir)

    local filename
    if path:match("^https?://") then
        local safe = path:gsub("[^%w%-_]", "_")
        filename = safe:sub(1,50) .. ".log"
    else
        local parts = utils.split_path(path)
        filename = (parts and parts[2]) or "output.log"
    end
    return utils.join_path(logdir, filename)
end

local function write_log(file, text)
    local f = io.open(file, "a")
    if f then
        f:write(os.date("[%Y-%m-%d %H:%M:%S] ") .. text .. "\n")
        f:close()
    end
end

-- ================= CLEAN URL =================
local function clean_url(url)
    local vid = url:match("[&?]v=([%w%-_]+)")
    if vid then
        return "youtube_" .. vid
    end
    local safe = url:gsub("[^%w%-_]", "_")
    return safe:sub(1,50)
end

-- ================= YTDLP -F =================
local function ytdlp_list_formats(url)
    local res = utils.subprocess({
        args = {"yt-dlp", "-F", url},
        cancellable = false
    })
    if res.status ~= 0 or not res.stdout then
        return nil
    end

    local formats = {}
    for line in res.stdout:gmatch("[^\r\n]+") do
        if line:match("^%d") then
            local fid, ext, reso = line:match("^(%d+)%s+(%S+)%s+(%d+x%d+)")
            if fid and reso then
                local w,h = reso:match("(%d+)x(%d+)")
                formats[#formats+1] = {
                    format_id = fid,
                    ext       = ext,
                    width     = tonumber(w),
                    height    = tonumber(h)
                }
            end
        end
    end
    return formats
end

-- ================= MAIN =================
local function inspect_format()
    local path = mp.get_property("path")
    if not path then return end
    local logfile = make_logfile(path)

    local key = path
    local is_url = false
    if path:match("^https?://") then
        key = clean_url(path)
        is_url = true
    end

    -- ================= CACHE RAM =================
    if cache[key] then
        local info = cache[key]
        write_log(logfile, "=== USING RAM-CACHED FORMAT INFO ===")
        write_log(logfile, utils.format_json(info))
        mp.command_native({
            "script-message", "current-format",
            utils.format_json(info)
        })
        return
    end

    local info = {}
    info.width  = mp.get_property("width") or "?"
    info.height = mp.get_property("height") or "?"

    if is_url then
        local formats = ytdlp_list_formats(path)
        local fmt_id = mp.get_property("options/ytdl-format") or "unknown"
        info.format_id = fmt_id
        info.vcodec    = mp.get_property("video-codec") or "unknown"
        info.acodec    = mp.get_property("audio-codec") or "unknown"
        info.formats   = formats
    else
        info.vcodec = mp.get_property("video-codec") or "unknown"
        info.acodec = mp.get_property("audio-codec") or "unknown"
        info.format_id = "local"
    end

    -- Lưu cache RAM
    cache[key] = info

    -- Ghi log
    local f = io.open(logfile, "w")
    if f then f:close() end
    write_log(logfile, "=== NEW FILE LOADED ===")
    write_log(logfile, "FILE: " .. path)
    write_log(logfile, utils.format_json(info))

    -- Push sang mpv/UI
    mp.command_native({
        "script-message", "current-format",
        utils.format_json(info)
    })
end

mp.register_event("file-loaded", inspect_format)
